<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1A2B4A">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    <!-- Google Fonts: DM Serif Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- comment -%} JSON-LD SEO Structured Data (Inlined for reliability) {%- endcomment -%}
    {%- liquid
      assign logo_url = 'paw-and-home-logo.svg' | asset_url
      unless logo_url contains '://'
        if logo_url contains '//'
          assign logo_url = logo_url | prepend: 'https:'
        else
          assign logo_url = shop.url | append: logo_url
        endif
      endunless
    -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {{ logo_url | json }},
      "contactPoint": {
        "@type": "ContactPoint",
        "email": {{ shop.email | json }},
        "contactType": "customer service"
      },
      "sameAs": []
    }
    </script>
    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ shop.url | append: '/search?q={search_term_string}' | json }},
          "query-input": "required name=search_term_string"
        }
      }
      </script>
    {%- endif -%}
    {%- if request.page_type == 'collection' or request.page_type == 'product' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'paw.json_ld.home' | t | default: 'Inicio' | json }},
            "item": {{ shop.url | json }}
          }
          {%- if request.page_type == 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ shop.url | append: collection.url | json }}
            }
          {%- elsif request.page_type == 'product' -%}
            {%- if product.collections.size > 0 -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.collections.first.title | json }},
                "item": {{ shop.url | append: product.collections.first.url | json }}
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": {{ shop.url | append: product.url | json }}
              }
            {%- else -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": {{ shop.url | append: product.url | json }}
              }
            {%- endif -%}
          {%- endif -%}
        ]
      }
      </script>
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
      {%- liquid
        assign current_variant = product.selected_or_first_available_variant
        assign product_description = product.description | strip_html | strip_newlines | default: product.title
        if product.featured_image
          assign product_image_url = product.featured_image | image_url: width: 1024
        elsif product.images.first
          assign product_image_url = product.images.first | image_url: width: 1024
        else
          assign product_image_url = 'paw-and-home-logo.svg' | asset_url
        endif
        unless product_image_url contains '://'
          if product_image_url contains '//'
            assign product_image_url = product_image_url | prepend: 'https:'
          else
            assign product_image_url = shop.url | append: product_image_url
          endif
        endunless
        if current_variant.available
          assign product_availability = 'https://schema.org/InStock'
        elsif product.available
          assign product_availability = 'https://schema.org/InStock'
        else
          assign product_availability = 'https://schema.org/OutOfStock'
        endif
        assign product_sku = current_variant.sku | default: product.id
      -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product_description | json }},
        "image": {{ product_image_url | json }},
        "sku": {{ product_sku | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ shop.name | json }}
        },
        "offers": {
          "@type": "Offer",
          "price": {{ product.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ shop.currency | json }},
          "availability": {{ product_availability | json }},
          "url": {{ shop.url | append: product.url | json }}
        }
      }
      </script>
    {%- endif -%}

    <link href="{{ 'bootstrap.min.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'themify-icons.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'style.css' | asset_url }}" rel="stylesheet">
    <link href="{{ 'pet-theme.css' | asset_url }}" rel="stylesheet">

    {{ content_for_header }}
  </head>

  <body class="">
    <div class="page-wrapper">
      {% section 'announcement-bar' %}
      {% section 'header' %}

      {{ content_for_layout }}

      {% section 'trust-banner' %}
      {% section 'footer' %}
    </div>

    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
    <script src="{{ 'bootstrap.bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'jquery-plugin-collection.js' | asset_url }}" defer></script>
    <script src="{{ 'script.js' | asset_url }}" defer></script>
    <script src="{{ 'pet-theme.js' | asset_url }}" defer></script>

    {% render 'cookie-banner' %}
    {% section 'whatsapp-button' %}
    {% render 'floating-ui' %}
    {% render 'newsletter-popup' %}
  </body>
</html>
