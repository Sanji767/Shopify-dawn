<section class="pet-section pet-track-order-section" style="padding: 70px 0; background-color: var(--pet-white, #FFFFFF);">
  <div class="pet-container container" style="max-width: 820px; margin: 0 auto; padding: 0 20px;">
    
    <!-- Section Header -->
    <div style="text-align: center; margin-bottom: 44px;">
      <span style="display: inline-block; padding: 6px 16px; background: #F5EDE3; border: 1px solid #E8734A; border-radius: 50px; font-size: 0.8rem; font-weight: 700; color: var(--pet-coral, #E8734A); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 16px;">
        {{ 'paw.track.badge' | t }}
      </span>
      <h1 style="font-family: 'DM Serif Display', serif; font-size: 2.8rem; color: var(--pet-navy, #1A2B4A); margin-bottom: 16px; line-height: 1.2;">
        {{ 'paw.track.title' | t }}
      </h1>
      <p style="font-family: 'Inter', sans-serif; font-size: 1.05rem; color: var(--pet-muted, #6B7280); line-height: 1.6; max-width: 620px; margin: 0 auto;">
        {{ 'paw.track.subtitle' | t }}
      </p>
    </div>

    <!-- Tracking Form Box -->
    <div style="background: var(--pet-cream, #FBF8F3); border: 1px solid var(--pet-border, #E5E1DB); border-radius: 20px; padding: 36px 30px; box-shadow: 0 10px 30px rgba(26, 43, 74, 0.05); margin-bottom: 48px;">
      <form id="pawTrackingForm" onsubmit="handleTrackingSearch(event)" style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <input 
            type="text" 
            id="pawTrackingInput" 
            placeholder="{{ 'paw.track.input_placeholder' | t }}" 
            required 
            style="flex: 1; min-width: 260px; padding: 16px 20px; border-radius: 50px; border: 1px solid var(--pet-border, #E5E1DB); font-size: 1rem; background: #FFFFFF; color: var(--pet-navy, #1A2B4A); outline: none; font-family: 'Inter', sans-serif; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);"
          >
          <button 
            type="submit" 
            class="pet-btn pet-btn-primary" 
            style="padding: 16px 32px; border-radius: 50px; font-weight: 700; font-size: 1rem; border: none; background: var(--pet-coral, #E8734A); color: #FFFFFF; cursor: pointer; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(232, 115, 74, 0.35);"
          >
            🔍 {{ 'paw.track.button' | t }}
          </button>
        </div>
        <p style="margin: 4px 0 0; font-size: 0.85rem; color: var(--pet-muted, #8A8580); text-align: center;">
          {{ 'paw.track.hint' | t }}
        </p>
      </form>

      <!-- Results Container -->
      <div id="pawTrackingResult" style="display: none; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--pet-border, #E5E1DB);">
        <p style="font-size: 0.95rem; font-weight: 600; color: var(--pet-navy); margin-bottom: 12px;" id="pawTrackingStatusText"></p>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a id="pawTrackingDirectLink" href="#" target="_blank" rel="noopener noreferrer" class="pet-btn pet-btn-secondary" style="padding: 10px 20px; border-radius: 50px; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background: #FFFFFF; border: 1px solid var(--pet-navy); color: var(--pet-navy); font-weight: 600;">
            Abrir seguimiento oficial ↗
          </a>
          <a href="/pages/contact" class="pet-btn" style="padding: 10px 20px; border-radius: 50px; font-size: 0.9rem; text-decoration: none; color: var(--pet-muted); background: #F4F1EC;">
            Contactar con soporte
          </a>
        </div>
      </div>
    </div>

    <!-- 3 Info Feature Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
      <div style="background: #FFFFFF; border: 1px solid var(--pet-border, #E5E1DB); border-radius: 16px; padding: 24px 20px; text-align: center; box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
        <div style="font-size: 2rem; margin-bottom: 12px;">⏱️</div>
        <h3 style="font-size: 1.1rem; color: var(--pet-navy); margin-bottom: 8px; font-weight: 700;">{{ 'paw.track.card_time_title' | t }}</h3>
        <p style="font-size: 0.85rem; color: var(--pet-muted); line-height: 1.5; margin: 0;">{{ 'paw.track.card_time_desc' | t }}</p>
      </div>

      <div style="background: #FFFFFF; border: 1px solid var(--pet-border, #E5E1DB); border-radius: 16px; padding: 24px 20px; text-align: center; box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
        <div style="font-size: 2rem; margin-bottom: 12px;">🚚</div>
        <h3 style="font-size: 1.1rem; color: var(--pet-navy); margin-bottom: 8px; font-weight: 700;">{{ 'paw.track.card_carrier_title' | t }}</h3>
        <p style="font-size: 0.85rem; color: var(--pet-muted); line-height: 1.5; margin: 0;">{{ 'paw.track.card_carrier_desc' | t }}</p>
      </div>

      <div style="background: #FFFFFF; border: 1px solid var(--pet-border, #E5E1DB); border-radius: 16px; padding: 24px 20px; text-align: center; box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
        <div style="font-size: 2rem; margin-bottom: 12px;">💬</div>
        <h3 style="font-size: 1.1rem; color: var(--pet-navy); margin-bottom: 8px; font-weight: 700;">{{ 'paw.track.card_help_title' | t }}</h3>
        <p style="font-size: 0.85rem; color: var(--pet-muted); line-height: 1.5; margin: 0;">{{ 'paw.track.card_help_desc' | t }}</p>
      </div>
    </div>

  </div>
</section>

<script>
  function handleTrackingSearch(e) {
    e.preventDefault();
    var input = document.getElementById('pawTrackingInput');
    var code = input.value.trim();
    if (!code) return;

    var resultBox = document.getElementById('pawTrackingResult');
    var statusText = document.getElementById('pawTrackingStatusText');
    var directLink = document.getElementById('pawTrackingDirectLink');

    var lang = '{{ request.locale.iso_code | default: "es" }}';
    var trackUrl = 'https://t.17track.net/' + (lang === 'en' ? 'en' : 'es') + '#nums=' + encodeURIComponent(code);

    statusText.textContent = (lang === 'en' ? 'Searching tracking details for #' : 'Localizando el paquete con número #') + code + '...';
    directLink.href = trackUrl;
    resultBox.style.display = 'block';

    window.open(trackUrl, '_blank');
  }
</script>

{% schema %}
{
  "name": "Seguimiento de Pedido",
  "settings": [],
  "presets": [
    {
      "name": "Seguimiento de Pedido"
    }
  ]
}
{% endschema %}
