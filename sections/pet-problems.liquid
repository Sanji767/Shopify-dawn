{{ 'pet-theme.css' | asset_url | stylesheet_tag }}

<section class="pet-section pet-problems-section" style="background-color: {{ section.settings.background_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pet-container container">
    {% if section.settings.title != blank %}
      <h2 class="pet-section-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="pet-section-subtitle" style="color: {{ section.settings.subtitle_color }};">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    <div class="pet-problems-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="pet-problem-col" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="pet-problem-card">
              <div class="pet-problem-card__icon-wrapper">
                <span class="pet-problem-card__emoji" aria-hidden="true">{{ block.settings.emoji | default: '💡' }}</span>
              </div>

              <div class="pet-problem-card__content">
                {% if block.settings.problem != blank %}
                  <h3 class="pet-problem-card__question">{{ block.settings.problem }}</h3>
                {% endif %}

                <div class="pet-problem-card__divider"></div>

                {% if block.settings.solution != blank %}
                  <p class="pet-problem-card__solution">{{ block.settings.solution }}</p>
                {% endif %}

                <span class="pet-problem-card__cta">
                  {{ block.settings.link_text | default: 'Ver solución' }}
                  <svg class="pet-problem-card__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        {% assign def_emojis = "🛋️,🚗,🐾,🛏️" | split: "," %}
        {% assign def_probs = "¿Tu sofá parece tener su propio abrigo de pelos?,¿Ir en coche con tu peludo es un mar de nervios o pelos?,¿Llega del paseo y deja huellitas por toda la casa?,¿Notas que le cuesta levantarse tras una siesta larga?" | split: "," %}
        {% assign def_sols = "Descubre cómo tenerlo limpio en segundos sin estropear las telas.,Mantas y protectores impermeables para que viaje seguro y relajado.,Soluciones suaves para limpiar sus patitas antes de entrar al salón.,Camas ortopédicas con viscoelástica para cuidar sus articulaciones." | split: "," %}
        {% for i in (0..3) %}
          <div class="pet-problem-col">
            <a href="/collections/all" class="pet-problem-card">
              <div class="pet-problem-card__icon-wrapper">
                <span class="pet-problem-card__emoji" aria-hidden="true">{{ def_emojis[i] }}</span>
              </div>
              <div class="pet-problem-card__content">
                <h3 class="pet-problem-card__question">{{ def_probs[i] }}</h3>
                <div class="pet-problem-card__divider"></div>
                <p class="pet-problem-card__solution">{{ def_sols[i] }}</p>
                <span class="pet-problem-card__cta">
                  Ver solución
                  <svg class="pet-problem-card__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pet-problems-section {
    background-color: var(--pet-warm, #F5EDE3);
    padding: 80px 0;
  }
  .pet-problems-section .pet-section-title {
    font-family: 'DM Serif Display', serif;
    font-size: 2.5rem;
    color: var(--pet-navy, #1A2B4A);
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .pet-problems-section .pet-section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: var(--pet-muted, #6B7280);
    text-align: center;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .pet-problems-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    width: 100%;
  }
  .pet-problem-col {
    width: 100%;
    display: flex;
  }
  .pet-problem-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    background-color: #FFFFFF;
    border: 1px solid #E5E1DB;
    border-radius: 20px;
    padding: 2.25rem 1.5rem;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }
  .pet-problem-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 36px rgba(26, 43, 74, 0.1);
    border-color: var(--pet-coral);
  }
  .pet-problem-card__icon-wrapper {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #FBF8F3;
    border: 1px solid #E5E1DB;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 14px rgba(26, 43, 74, 0.05);
    transition: transform 0.3s ease;
  }
  .pet-problem-card:hover .pet-problem-card__icon-wrapper {
    transform: scale(1.1) rotate(-6deg);
    background: #FFF;
  }
  .pet-problem-card__emoji {
    font-size: 2.25rem;
    line-height: 1;
  }
  .pet-problem-card__content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
  }
  .pet-problem-card__question {
    font-family: 'DM Serif Display', serif;
    font-size: 1.25rem;
    color: var(--pet-navy, #1A2B4A);
    margin: 0 0 0.75rem;
    line-height: 1.35;
  }
  .pet-problem-card__divider {
    width: 32px;
    height: 2px;
    background-color: var(--pet-coral);
    margin: 0 auto 0.75rem;
    border-radius: 2px;
    transition: width 0.3s ease;
  }
  .pet-problem-card:hover .pet-problem-card__divider {
    width: 60px;
  }
  .pet-problem-card__solution {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--pet-muted, #6B7280);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }
  .pet-problem-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--pet-coral);
    margin-top: auto;
    transition: gap 0.2s ease;
  }
  .pet-problem-card:hover .pet-problem-card__cta {
    gap: 10px;
  }

  @media (max-width: 991px) {
    .pet-problems-section .pet-section-title { font-size: 2rem; }
    .pet-problems-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 575px) {
    .pet-problems-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>

{% schema %}
{
  "name": "Problemas & Soluciones",
  "tag": "section",
  "class": "pet-problems-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Tenemos la solución a tu día a día"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Resolvemos las situaciones más comunes al convivir con mascotas"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#F5EDE3"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#1A2B4A"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del subtítulo",
      "default": "#6B7280"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problema",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "🛋️"
        },
        {
          "type": "text",
          "id": "problem",
          "label": "Pregunta / Problema",
          "default": "¿Tu sofá está lleno de pelos?"
        },
        {
          "type": "textarea",
          "id": "solution",
          "label": "Solución",
          "default": "Descubre nuestros productos de limpieza"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Texto enlace",
          "default": "Ver solución"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace a colección"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problemas & Soluciones"
    }
  ]
}
{% endschema %}
