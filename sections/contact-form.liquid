<!-- Contact Page -->
<section class="pet-section" style="background: var(--pet-white);">
  <div class="pet-container">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-12">
        <div style="text-align: center; margin-bottom: 40px;">
          <h1 style="font-size: 2.5rem; margin-bottom: 8px;">{{ section.settings.title }}</h1>
          <p style="color: var(--pet-muted);">{{ section.settings.subtitle }}</p>
        </div>

        {% form 'contact' %}
          <div class="row">
            <div class="col-lg-6 col-12 mb-3">
              <input type="text" name="contact[firstName]" placeholder="Nombre" required
                style="width: 100%; padding: 14px 16px; border: 1px solid var(--pet-border); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.9rem;">
            </div>
            <div class="col-lg-6 col-12 mb-3">
              <input type="text" name="contact[lastName]" placeholder="Apellido"
                style="width: 100%; padding: 14px 16px; border: 1px solid var(--pet-border); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.9rem;">
            </div>
            <div class="col-12 mb-3">
              <input type="email" name="contact[email]" placeholder="Email" required
                style="width: 100%; padding: 14px 16px; border: 1px solid var(--pet-border); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.9rem;">
            </div>
            <div class="col-12 mb-3">
              <textarea name="contact[message]" placeholder="Mensaje" rows="5" required
                style="width: 100%; padding: 14px 16px; border: 1px solid var(--pet-border); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.9rem; resize: vertical;"></textarea>
            </div>
            <div class="col-12">
              <button type="submit" class="pet-btn pet-btn-primary" style="width: 100%;">Enviar mensaje</button>
            </div>

            {% if form.posted_successfully? %}
              <div class="col-12 mt-3">
                <p style="text-align: center; color: var(--pet-sage); font-weight: 500;">¡Gracias por contactarnos! Te responderemos lo antes posible. 🐾</p>
              </div>
            {% endif %}
            {% if form.errors %}
              <div class="col-12 mt-3">
                <p style="text-align: center; color: var(--pet-error);">{{ form.errors | default_errors }}</p>
              </div>
            {% endif %}
          </div>
        {% endform %}

        {% if section.settings.company != blank %}
          <div style="text-align: center; margin-top: 40px; color: var(--pet-muted); font-size: 0.85rem;">
            <p><strong>{{ section.settings.company }}</strong></p>
            <p>{{ section.settings.address }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contacto",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Contáctanos"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "¿Tienes alguna pregunta? Estamos aquí para ayudarte."
    },
    {
      "type": "text",
      "id": "company",
      "label": "Empresa"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Dirección"
    }
  ],
  "presets": [
    {
      "name": "Contacto"
    }
  ]
}
{% endschema %}
