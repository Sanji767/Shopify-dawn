<section class="pet-section" style="background-color: var(--pet-cream); min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 80px 20px;">
  <div class="pet-container container" style="max-width: 600px;">
    <div style="font-size: 5rem; margin-bottom: 20px;">🐶 🐾</div>
    <h1 style="font-family: 'DM Serif Display', serif; font-size: 3rem; color: var(--pet-navy); margin-bottom: 16px;">
      {{ 'paw.error_404.title' | t }}
    </h1>
    <p style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: var(--pet-muted); line-height: 1.6; margin-bottom: 32px;">
      {{ 'paw.error_404.text' | t }}
    </p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="{{ routes.root_url }}" class="pet-btn pet-btn-primary" style="padding: 14px 32px; border-radius: 50px; text-decoration: none;">
        {{ 'paw.error_404.back_home' | t }}
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="pet-btn pet-btn-secondary" style="padding: 14px 32px; border-radius: 50px; text-decoration: none; border: 2px solid var(--pet-navy); color: var(--pet-navy);">
        {{ 'paw.error_404.view_all_products' | t }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página 404",
  "tag": "section",
  "class": "pet-404-section"
}
{% endschema %}
