{{ 'pet-theme.css' | asset_url | stylesheet_tag }}

<section class="pet-section" style="background-color: var(--pet-cream); min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 80px 20px;">
  <div class="pet-container container" style="max-width: 600px;">
    <div style="font-size: 5rem; margin-bottom: 20px;">🐶 🐾</div>
    <h1 style="font-family: 'DM Serif Display', serif; font-size: 3rem; color: var(--pet-navy); margin-bottom: 16px;">
      ¡Ups! Página no encontrada
    </h1>
    <p style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: var(--pet-muted); line-height: 1.6; margin-bottom: 32px;">
      Parece que esta página o categoría aún no se ha creado en el panel de control de Shopify.
    </p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="pet-btn pet-btn-primary" style="padding: 14px 32px; border-radius: 50px; text-decoration: none;">
        Volver al Inicio
      </a>
      <a href="/collections/all" class="pet-btn pet-btn-secondary" style="padding: 14px 32px; border-radius: 50px; text-decoration: none; border: 2px solid var(--pet-navy); color: var(--pet-navy);">
        Ver todos los productos
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página 404",
  "tag": "section",
  "class": "pet-404-section"
}
{% endschema %}
