<section class="pet-section pet-main-page" style="padding: 80px 0; background-color: var(--pet-white, #FFFFFF);">
  <div class="pet-container container" style="max-width: 800px;">
    <header class="pet-page-header" style="text-align: center; margin-bottom: 40px;">
      <h1 class="pet-page-title" style="font-family: 'DM Serif Display', serif; font-size: 2.75rem; color: var(--pet-navy, #1A2B4A);">
        {% assign _pt = 'paw.page.title_fallback' | t %}{{ page.title | default: _pt }}
      </h1>
    </header>

    <div class="pet-page-content" style="font-family: 'Inter', sans-serif; font-size: 1rem; color: var(--pet-navy, #1A2B4A); line-height: 1.8;">
      {% if page.content != blank %}
        {{ page.content }}
      {% else %}
        <!-- Rich Default Fallback Copy when page has no content yet -->
        {% if page.handle contains 'about' or page.title contains 'Sobre' %}
          <h3>{{ 'paw.page.welcome_title' | t }}</h3>
          <p>{{ 'paw.page.welcome_text' | t }}</p>
          <p>{{ 'paw.page.quality_text' | t }}</p>
        {% elsif page.handle contains 'shipping' or page.title contains 'Envío' %}
          <h3>{{ 'paw.page.shipping_title' | t }}</h3>
          <p>{{ 'paw.page.shipping_delivery' | t }}</p>
          <p>{{ 'paw.page.shipping_costs' | t }}</p>
          <ul>
            <li>{{ 'paw.page.shipping_free' | t }}</li>
            <li>{{ 'paw.page.shipping_flat' | t }}</li>
          </ul>
          <p>{{ 'paw.page.shipping_tracking' | t }}</p>
        {% elsif page.handle contains 'refund' or page.title contains 'Devoluc' %}
          <h3>{{ 'paw.page.returns_title' | t }}</h3>
          <p>{{ 'paw.page.returns_text' | t }}</p>
          <p>{{ 'paw.page.returns_requirements' | t }}</p>
          <p>{{ 'paw.page.returns_contact' | t }}</p>
        {% elsif page.handle contains 'privacy' or page.title contains 'Privacidad' %}
          <h3>{{ 'paw.page.privacy_title' | t }}</h3>
          <p>{{ 'paw.page.privacy_text' | t }}</p>
          <p>{{ 'paw.page.privacy_contact' | t }}</p>
          <p>{{ 'paw.page.privacy_controller' | t }}</p>
        {% elsif page.handle contains 'terms' or page.title contains 'Términos' %}
          <h3>{{ 'paw.page.terms_title' | t }}</h3>
          <p>{{ 'paw.page.terms_text' | t }}</p>
          <p>{{ 'paw.page.terms_changes' | t }}</p>
        {% else %}
          <h3>{{ 'paw.page.site_info_title' | t }}</h3>
          <p>{{ 'paw.page.site_info_text' | t }}</p>
          <p style="margin-top: 24px;"><a href="/pages/contact" class="pet-btn pet-btn-primary">{{ 'paw.page.go_to_contact' | t }}</a></p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página Principal",
  "tag": "section",
  "class": "pet-main-page-section"
}
{% endschema %}
