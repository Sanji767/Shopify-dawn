<section class="pet-section" style="background: var(--pet-white);">
  <div class="pet-container">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-12">
        <div class="pet-section-title">
          <h1>{{ page.title }}</h1>
        </div>
        <div style="line-height: 1.8; font-size: 0.95rem; color: var(--pet-navy);">
          {{ page.content }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contenido de página",
  "settings": [],
  "presets": [
    {
      "name": "Contenido de página"
    }
  ]
}
{% endschema %}
