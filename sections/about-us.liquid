<div class="pet-section" style="background: var(--pet-white);">
  <div class="pet-container">
    <div class="pet-section-title">
      <h2>{{ section.settings.title }}</h2>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-8 col-12" style="text-align: center;">
        <p style="font-weight: 600; color: var(--pet-coral); margin-bottom: 8px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;">{{ section.settings.subtitle }}</p>
        <h3 style="font-size: 1.5rem; margin-bottom: 24px;">{{ section.settings.heading }}</h3>
        <div style="color: var(--pet-muted); line-height: 1.8; font-size: 0.95rem;">
          {{ section.settings.description }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sobre nosotros",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "NUESTRA HISTORIA"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "CREAMOS ALGO ESPECIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Encabezado",
      "default": "Productos para vivir mejor con ellos"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Somos una tienda creada por amantes de los animales que entienden los retos y alegrías de vivir con una mascota. Seleccionamos cuidadosamente cada producto para que tanto tú como tu compañero peludo disfrutéis de la mejor calidad, diseño y funcionalidad.</p><p>No vendemos solo productos para mascotas. Vendemos productos para vivir mejor con ellas.</p>"
    }
  ],
  "presets": [
    {
      "name": "Sobre nosotros"
    }
  ]
}
{% endschema %}
