{%- if section.settings.phone_number != blank -%}
  {%- assign clean_phone = section.settings.phone_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', '' | strip -%}
  {%- assign encoded_message = section.settings.default_message | url_param_escape -%}
  {%- capture whatsapp_url -%}
    https://wa.me/{{ clean_phone }}{% if encoded_message != blank %}?text={{ encoded_message }}{% endif %}
  {%- endcapture -%}

  <div class="pet-whatsapp-container" id="pet-whatsapp-{{ section.id }}">
    {%- if section.settings.show_tooltip and section.settings.tooltip_text != blank -%}
      <aside
        id="pet-whatsapp-tooltip-{{ section.id }}"
        class="pet-whatsapp-tooltip"
        role="tooltip"
        aria-label="{{ section.settings.tooltip_text | escape }}"
      >
        <a
          href="{{ whatsapp_url | strip }}"
          class="pet-whatsapp-tooltip-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Abrir chat de WhatsApp"
        >
          <span class="pet-whatsapp-tooltip-text">{{ section.settings.tooltip_text }}</span>
        </a>
        <button
          type="button"
          class="pet-whatsapp-tooltip-close"
          aria-label="Cerrar sugerencia de ayuda"
          title="Cerrar mensaje"
          onclick="petDismissWhatsAppTooltip(event, '{{ section.id }}')"
        >
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" focusable="false">
            <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="pet-whatsapp-tooltip-arrow" aria-hidden="true"></div>
      </aside>
    {%- endif -%}

    <a
      href="{{ whatsapp_url | strip }}"
      class="pet-whatsapp-btn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp con Paw & Home"
      title="Contactar por WhatsApp"
      {% if section.settings.show_tooltip and section.settings.tooltip_text != blank %}
        aria-describedby="pet-whatsapp-tooltip-{{ section.id }}"
      {% endif %}
    >
      <span class="pet-whatsapp-pulse" aria-hidden="true"></span>
      <svg
        class="pet-whatsapp-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        width="32"
        height="32"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
      </svg>
    </a>
  </div>

  <style>
    /* ============================================================
       PAW & HOME — Floating WhatsApp Contact Section
       ============================================================ */
    .pet-whatsapp-container {
      position: fixed;
      bottom: calc(20px + env(safe-area-inset-bottom, 0px));
      right: calc(20px + env(safe-area-inset-right, 0px));
      z-index: 999;
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      pointer-events: none;
    }

    /* ---- Circular WhatsApp Button ---- */
    .pet-whatsapp-btn {
      pointer-events: auto;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      min-width: 56px;
      min-height: 56px;
      border-radius: var(--radius-full, 9999px);
      background-color: #25D366;
      color: #FFFFFF;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16), 0 2px 6px rgba(26, 43, 74, 0.08);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, background-color 0.2s ease;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    /* Bounce hover animation */
    .pet-whatsapp-btn:hover {
      background-color: #22BF5B;
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.42), 0 4px 12px rgba(26, 43, 74, 0.14);
      animation: petWhatsAppHoverBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .pet-whatsapp-btn:active {
      transform: scale(0.95) translateY(0);
      box-shadow: 0 2px 8px rgba(37, 211, 102, 0.3);
    }

    .pet-whatsapp-btn:focus-visible {
      outline: 3px solid var(--pet-coral, #E8734A);
      outline-offset: 3px;
    }

    .pet-whatsapp-icon {
      display: block;
      width: 32px;
      height: 32px;
      fill: currentColor;
      transition: transform 0.25s ease;
    }

    .pet-whatsapp-btn:hover .pet-whatsapp-icon {
      transform: scale(1.06);
    }

    /* Subtle pulse animation on first load */
    .pet-whatsapp-pulse {
      position: absolute;
      inset: -3px;
      border-radius: var(--radius-full, 9999px);
      background-color: #25D366;
      pointer-events: none;
      z-index: -1;
      opacity: 0;
      animation: petWhatsAppPulseWave 2.2s cubic-bezier(0.16, 1, 0.3, 1) 3;
    }

    @keyframes petWhatsAppPulseWave {
      0% {
        transform: scale(0.96);
        opacity: 0.65;
      }
      65% {
        transform: scale(1.48);
        opacity: 0;
      }
      100% {
        transform: scale(1.48);
        opacity: 0;
      }
    }

    @keyframes petWhatsAppHoverBounce {
      0% {
        transform: scale(1) translateY(0);
      }
      30% {
        transform: scale(1.1) translateY(-6px);
      }
      60% {
        transform: scale(0.97) translateY(0px);
      }
      80% {
        transform: scale(1.05) translateY(-3px);
      }
      100% {
        transform: scale(1.04) translateY(-3px);
      }
    }

    /* ---- Tooltip Speech Bubble ---- */
    .pet-whatsapp-tooltip {
      pointer-events: auto;
      position: absolute;
      right: calc(100% + 14px);
      top: 50%;
      transform: translateY(-50%) translateX(8px);
      background-color: var(--pet-white, #FFFFFF);
      color: var(--pet-navy, #1A2B4A);
      border: 1px solid var(--pet-border, #E5E1DB);
      border-radius: var(--radius-full, 9999px);
      padding: 8px 12px 8px 16px;
      box-shadow: 0 4px 20px rgba(26, 43, 74, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.25s ease;
      animation: petWhatsAppTooltipEntrance 7s ease 1.2s 1;
      z-index: 1000;
    }

    @keyframes petWhatsAppTooltipEntrance {
      0% {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-50%) translateX(10px);
      }
      12% {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(0);
      }
      85% {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(0);
      }
      100% {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-50%) translateX(6px);
      }
    }

    /* Tooltip arrow pointing towards the button */
    .pet-whatsapp-tooltip-arrow {
      position: absolute;
      top: 50%;
      right: -6px;
      transform: translateY(-50%) rotate(45deg);
      width: 10px;
      height: 10px;
      background-color: var(--pet-white, #FFFFFF);
      border-top: 1px solid var(--pet-border, #E5E1DB);
      border-right: 1px solid var(--pet-border, #E5E1DB);
      border-bottom: none;
      border-left: none;
    }

    .pet-whatsapp-tooltip-link {
      text-decoration: none;
      color: var(--pet-navy, #1A2B4A);
      font-family: var(--font-body, 'Inter', sans-serif);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.3;
      display: flex;
      align-items: center;
      transition: color 0.15s ease;
    }

    .pet-whatsapp-tooltip-link:hover {
      color: var(--pet-coral, #E8734A);
    }

    .pet-whatsapp-tooltip-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      color: var(--pet-muted, #8A8580);
      cursor: pointer;
      padding: 4px;
      margin-left: 2px;
      border-radius: 50%;
      line-height: 1;
      transition: color 0.15s ease, background-color 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .pet-whatsapp-tooltip-close:hover {
      color: var(--pet-navy, #1A2B4A);
      background-color: var(--pet-warm, #F5EDE3);
    }

    .pet-whatsapp-tooltip-close:focus-visible {
      outline: 2px solid var(--pet-coral, #E8734A);
      outline-offset: 1px;
    }

    /* Hover and focus display triggers */
    .pet-whatsapp-container:hover .pet-whatsapp-tooltip:not(.pet-tooltip-hidden),
    .pet-whatsapp-container:focus-within .pet-whatsapp-tooltip:not(.pet-tooltip-hidden) {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateY(-50%) translateX(0) !important;
      animation: none !important;
    }

    /* Suppressed on repeat views after dismissal */
    .pet-whatsapp-tooltip.pet-tooltip-suppress-initial {
      animation: none !important;
    }

    .pet-whatsapp-tooltip.pet-tooltip-hidden {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
      animation: none !important;
    }

    /* ---- Mobile Responsive Styles ---- */
    @media (max-width: 767px) {
      .pet-whatsapp-container {
        bottom: calc(20px + env(safe-area-inset-bottom, 0px));
        right: calc(20px + env(safe-area-inset-right, 0px));
      }

      .pet-whatsapp-btn {
        width: 50px;
        height: 50px;
        min-width: 50px;
        min-height: 50px;
      }

      .pet-whatsapp-icon {
        width: 28px;
        height: 28px;
      }

      .pet-whatsapp-tooltip {
        max-width: calc(100vw - 90px);
        white-space: normal;
        padding: 6px 10px 6px 14px;
      }

      .pet-whatsapp-tooltip-link {
        font-size: 12px;
      }
    }

    /* Reduced Motion Accessibility */
    @media (prefers-reduced-motion: reduce) {
      .pet-whatsapp-pulse {
        animation: none !important;
        display: none !important;
      }
      .pet-whatsapp-btn {
        transition: none !important;
      }
      .pet-whatsapp-btn:hover {
        animation: none !important;
        transform: translateY(-2px) !important;
      }
      .pet-whatsapp-tooltip {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>

  <script>
    (function() {
      var sectionId = '{{ section.id }}';

      try {
        if (sessionStorage.getItem('pet_wa_tooltip_dismissed') === 'true') {
          var tooltip = document.getElementById('pet-whatsapp-tooltip-' + sectionId);
          if (tooltip) {
            tooltip.classList.add('pet-tooltip-suppress-initial');
          }
        }
      } catch (err) {}

      window.petDismissWhatsAppTooltip = function(event, id) {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }
        var targetTooltip = document.getElementById('pet-whatsapp-tooltip-' + id);
        if (targetTooltip) {
          targetTooltip.classList.add('pet-tooltip-hidden');
        }
        try {
          sessionStorage.setItem('pet_wa_tooltip_dismissed', 'true');
        } catch (err) {}
      };
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Botón de WhatsApp",
  "tag": "aside",
  "class": "pet-whatsapp-section",
  "settings": [
    {
      "type": "header",
      "content": "Configuración de WhatsApp"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Número de WhatsApp con código país, ej: 34612345678",
      "info": "Introduce el prefijo del país seguido del número móvil sin espacios, guiones ni símbolo + (ejemplo: 34612345678)."
    },
    {
      "type": "text",
      "id": "default_message",
      "label": "Mensaje predeterminado",
      "default": "Hola 🐾 Tengo una pregunta sobre un producto de Paw & Home",
      "info": "Mensaje con el que se iniciará la conversación de WhatsApp al pulsar el botón."
    },
    {
      "type": "header",
      "content": "Mensaje emergente (Tooltip)"
    },
    {
      "type": "checkbox",
      "id": "show_tooltip",
      "label": "Mostrar mensaje emergente (tooltip)",
      "default": true,
      "info": "Muestra un globito informativo junto al botón al cargar la página y al pasar el cursor."
    },
    {
      "type": "text",
      "id": "tooltip_text",
      "label": "Texto del mensaje emergente",
      "default": "¿Necesitas ayuda? 🐾",
      "info": "Texto corto y cercano para invitar a tus clientes a escribirte."
    }
  ],
  "presets": [
    {
      "name": "Botón de WhatsApp"
    }
  ]
}
{% endschema %}
