{{ 'pet-theme.css' | asset_url | stylesheet_tag }}

<article class="pet-article-page" style="padding: 60px 0; background-color: var(--pet-white, #FFFFFF);">
  <div class="pet-container container" style="max-width: 840px;">
    <!-- Breadcrumb -->
    <nav class="pet-article-breadcrumb" style="margin-bottom: 24px; font-size: 0.85rem; color: var(--pet-muted);">
      <a href="/" style="color: var(--pet-muted);">Inicio</a>
      <span style="margin: 0 6px;">/</span>
      <a href="/blogs/news" style="color: var(--pet-muted);">Blog</a>
      <span style="margin: 0 6px;">/</span>
      <span style="color: var(--pet-navy); font-weight: 500;" id="artBreadcrumbTitle">{{ article.title | default: "Artículo de Pet Lifestyle" }}</span>
    </nav>

    <!-- Header -->
    <header class="pet-article-header" style="margin-bottom: 40px;">
      <span class="pet-article-category-badge" id="artBadge" style="display: inline-block; padding: 6px 16px; background: #F5EDE3; border-radius: 50px; font-size: 0.8rem; font-weight: 700; color: var(--pet-coral); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px;">
        Hogar y Limpieza
      </span>

      <h1 id="artTitle" style="font-family: 'DM Serif Display', serif; font-size: 3rem; color: var(--pet-navy); margin-bottom: 20px; line-height: 1.2;">
        {{ article.title | default: "5 Consejos para Mantener tu Sofá Libre de Pelos de Perro y Gato" }}
      </h1>

      <div class="pet-article-meta-bar" style="display: flex; align-items: center; gap: 16px; font-size: 0.9rem; color: var(--pet-muted); padding-bottom: 20px; border-bottom: 1px solid #E5E1DB;">
        <span>✍️ Por <strong id="artAuthor">{{ article.author | default: "Equipo Paw & Home" }}</strong></span>
        <span>•</span>
        <span>📅 {{ article.published_at | date: "%d de %B, %Y" | default: "28 de Agosto, 2026" }}</span>
        <span>•</span>
        <span id="artReadTime">⏱️ 4 min de lectura</span>
      </div>
    </header>

    <!-- Featured Visual -->
    <div class="pet-article-featured-media" style="margin-bottom: 40px; border-radius: 24px; overflow: hidden; background: linear-gradient(135deg, #FBF8F3 0%, #F5EDE3 100%); min-height: 380px; display: flex; align-items: center; justify-content: center; font-size: 5rem;" id="artEmojiContainer">
      {% if article.image %}
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" style="width: 100%; height: auto; display: block;">
      {% else %}
        <span id="artEmoji">🛋️</span>
      {% endif %}
    </div>

    <!-- Article Content Body -->
    <div class="pet-article-body" id="artBody" style="font-family: 'Inter', sans-serif; font-size: 1.05rem; color: var(--pet-navy); line-height: 1.8; margin-bottom: 48px;">
      {% if article.content != blank %}
        {{ article.content }}
      {% else %}
        <!-- Default Content injected dynamically via script below -->
      {% endif %}
    </div>

    <!-- Article Footer / Share -->
    <footer class="pet-article-footer" style="padding-top: 32px; border-top: 1px solid #E5E1DB; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <a href="/blogs/news" class="pet-btn pet-btn-secondary" style="padding: 10px 24px; border-radius: 50px; border: 1px solid var(--pet-navy); color: var(--pet-navy); text-decoration: none; font-size: 0.9rem;">
        ← Volver al Blog
      </a>
      <div style="display: flex; align-items: center; gap: 12px; font-size: 0.85rem; color: var(--pet-muted);">
        <span>Compartir:</span>
        <a href="#" style="color: var(--pet-navy); font-weight: 600;">Facebook</a>
        <a href="#" style="color: var(--pet-navy); font-weight: 600;">Pinterest</a>
        <a href="#" style="color: var(--pet-navy); font-weight: 600;">WhatsApp</a>
      </div>
    </footer>
  </div>
</article>

<script>
  var articlesData = {
    "1": {
