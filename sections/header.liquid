<!-- Header -->
<header class="pet-header" id="pet-header">
  <div class="pet-header-inner">
    <!-- Mobile Toggle (Left Column on Mobile) -->
    <button class="pet-mobile-toggle" aria-label="Abrir menú" onclick="document.querySelector('.pet-mobile-menu').classList.add('open'); document.querySelector('.pet-mobile-overlay').classList.add('open');">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <!-- Logo (Centered on Mobile, Left on Desktop) -->
    <a href="/" class="pet-header-logo">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" loading="eager" class="pet-logo-img">
      {% else %}
        <img src="{{ 'paw-and-home-logo.svg' | asset_url }}" alt="Paw & Home" class="pet-logo-img" loading="eager">
      {% endif %}
    </a>

    {% assign perros_link = section.settings.perros_url %}
    {% if perros_link == blank %}
      {% if collections['perros'] != blank and collections['perros'].title != blank %}
        {% assign perros_link = collections['perros'].url %}
      {% else %}
        {% assign perros_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    {% assign gatos_link = section.settings.gatos_url %}
    {% if gatos_link == blank %}
      {% if collections['gatos'] != blank and collections['gatos'].title != blank %}
        {% assign gatos_link = collections['gatos'].url %}
      {% else %}
        {% assign gatos_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    {% assign casa_link = section.settings.casa_url %}
    {% if casa_link == blank %}
      {% if collections['casa'] != blank and collections['casa'].title != blank %}
        {% assign casa_link = collections['casa'].url %}
      {% else %}
        {% assign casa_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    {% assign viajar_link = section.settings.viajar_url %}
    {% if viajar_link == blank %}
      {% if collections['viajar'] != blank and collections['viajar'].title != blank %}
        {% assign viajar_link = collections['viajar'].url %}
      {% else %}
        {% assign viajar_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    {% assign pasear_link = section.settings.pasear_url %}
    {% if pasear_link == blank %}
      {% if collections['pasear'] != blank and collections['pasear'].title != blank %}
        {% assign pasear_link = collections['pasear'].url %}
      {% else %}
        {% assign pasear_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    {% assign ofertas_link = section.settings.ofertas_url %}
    {% if ofertas_link == blank %}
      {% if collections['ofertas'] != blank and collections['ofertas'].title != blank %}
        {% assign ofertas_link = collections['ofertas'].url %}
      {% else %}
        {% assign ofertas_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    {% assign blog_link = section.settings.blog_url %}
    {% if blog_link == blank %}
      {% if blogs['news'] != blank and blogs['news'].title != blank %}
        {% assign blog_link = blogs['news'].url %}
      {% elsif blogs['blog'] != blank and blogs['blog'].title != blank %}
        {% assign blog_link = blogs['blog'].url %}
      {% else %}
        {% assign blog_link = '/collections/all' %}
      {% endif %}
    {% endif %}

    <!-- Desktop Navigation (Hidden on Mobile) -->
    <ul class="pet-header-nav">
      {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      {% else %}
        <li><a href="/">{{ section.settings.home_text }}</a></li>
        <li><a href="{{ perros_link }}">{{ section.settings.perros_text }}</a></li>
        <li><a href="{{ gatos_link }}">{{ section.settings.gatos_text }}</a></li>
        <li><a href="{{ casa_link }}">{{ section.settings.casa_text }}</a></li>
        <li><a href="{{ viajar_link }}">{{ section.settings.viajar_text }}</a></li>
        <li><a href="{{ pasear_link }}">{{ section.settings.pasear_text }}</a></li>
        <li><a href="{{ ofertas_link }}">{{ section.settings.ofertas_text }}</a></li>
        <li><a href="{{ blog_link }}">{{ section.settings.blog_text }}</a></li>
      {% endif %}
    </ul>

    <!-- Actions / Cart (Right Column) -->
    <div class="pet-header-actions">
      <a href="/cart" class="pet-header-cart-btn" aria-label="Ver Carrito">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="pet-cart-btn-text">Carrito</span>
        <span class="pet-header-cart-bubble">
          {{ cart.item_count | default: 0 }}
        </span>
      </a>
    </div>
  </div>
</header>

<style>
  .pet-header {
    position: sticky;
    top: 0;
    z-index: 990;
    background: #FFFFFF;
    border-bottom: 1px solid rgba(26, 43, 74, 0.08);
    transition: all 0.3s ease;
  }
  .pet-header-inner {
    max-width: var(--container-max, 1280px);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .pet-header-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .pet-logo-img {
    height: 42px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  .pet-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pet-header-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--pet-navy, #1A2B4A);
    color: #FFFFFF;
    padding: 9px 18px;
    border-radius: 50px;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 4px 14px rgba(26, 43, 74, 0.18);
    position: relative;
  }
  .pet-header-cart-bubble {
    background: #E8734A;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #FFFFFF;
    box-shadow: 0 2px 5px rgba(0,0,0,0.12);
  }

  /* Responsive Mobile Header Layout */
  @media (max-width: 991px) {
    .pet-header-inner {
      display: grid !important;
      grid-template-columns: 44px 1fr 44px !important;
      align-items: center !important;
      height: 60px !important;
      padding: 0 14px !important;
      gap: 8px !important;
    }
    .pet-mobile-toggle {
      display: flex !important;
      align-items: center;
      justify-content: flex-start;
      width: 44px;
      height: 44px;
      padding: 0;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--pet-navy, #1A2B4A);
    }
    .pet-header-logo {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      margin: 0 auto !important;
      width: 100% !important;
      text-align: center !important;
    }
    .pet-logo-img {
      height: 32px !important;
      max-height: 32px !important;
      max-width: 170px !important;
      width: auto !important;
      object-fit: contain;
    }
    .pet-header-actions {
      display: flex !important;
      justify-content: flex-end !important;
      align-items: center !important;
      width: 100% !important;
    }
    .pet-header-cart-btn {
      width: 40px !important;
      height: 40px !important;
      padding: 0 !important;
      border-radius: 50% !important;
      justify-content: center !important;
      position: relative !important;
    }
    .pet-cart-btn-text {
      display: none !important;
    }
    .pet-header-cart-bubble {
      position: absolute !important;
      top: -4px !important;
      right: -4px !important;
      min-width: 18px !important;
      height: 18px !important;
      font-size: 0.65rem !important;
      border: 2px solid #FFFFFF !important;
    }
  }
</style>

<!-- Mobile Menu Drawer -->
<div class="pet-mobile-overlay" onclick="this.classList.remove('open'); document.querySelector('.pet-mobile-menu').classList.remove('open');"></div>
<nav class="pet-mobile-menu">
  <div class="pet-mobile-menu-header" style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--pet-border, #E5E1DB); margin-bottom: 16px;">
    <span style="font-family: 'DM Serif Display', serif; font-size: 1.25rem; color: var(--pet-navy);">Paw &amp; Home 🐾</span>
    <button class="pet-mobile-menu-close" onclick="this.closest('.pet-mobile-menu').classList.remove('open'); document.querySelector('.pet-mobile-overlay').classList.remove('open');" aria-label="Cerrar menú" style="position: static; padding: 4px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <ul class="pet-mobile-nav">
    {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
      {% for link in linklists[section.settings.menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    {% else %}
      <li><a href="/">🏠 {{ section.settings.home_text | default: 'Inicio' }}</a></li>
      <li><a href="{{ perros_link }}">🐶 {{ section.settings.perros_text | default: 'Perros' }}</a></li>
      <li><a href="{{ gatos_link }}">🐱 {{ section.settings.gatos_text | default: 'Gatos' }}</a></li>
      <li><a href="{{ casa_link }}">🛋️ {{ section.settings.casa_text | default: 'Para casa' }}</a></li>
      <li><a href="{{ viajar_link }}">🚗 {{ section.settings.viajar_text | default: 'Para viajar' }}</a></li>
      <li><a href="{{ pasear_link }}">🦮 {{ section.settings.pasear_text | default: 'Para pasear' }}</a></li>
      <li><a href="{{ ofertas_link }}">🏷️ {{ section.settings.ofertas_text | default: 'Ofertas' }}</a></li>
      <li><a href="{{ blog_link }}">📖 {{ section.settings.blog_text | default: 'Consejos & Blog' }}</a></li>
    {% endif %}
  </ul>

  <!-- Mobile Drawer Footer Notice -->
  <div style="margin-top: 32px; padding: 16px; background: var(--pet-cream, #FBF8F3); border-radius: 12px; font-size: 0.8rem; color: var(--pet-muted, #6B7280); line-height: 1.5;">
    <p style="margin: 0 0 6px; font-weight: 700; color: var(--pet-navy);">🐾 Paw &amp; Home</p>
    <p style="margin: 0;">🚚 Envíos 3-6 días · 💚 14 días para probar con tu peludo</p>
  </div>
</nav>

<!-- Mini Cart Drawer -->
<div class="mini-cart">
  <div class="mini-cart-content">
    <button class="mini-cart-close" aria-label="Cerrar carrito">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="mini-cart-items">
      <p class="top-p" style="font-family: var(--font-heading); font-size: 1.3rem; color: var(--pet-navy);">Tu Carrito ({{ cart.item_count }})</p>

      {% if cart.item_count > 0 %}
        <!-- Free shipping bar -->
        {% assign free_shipping_threshold = 5000 %}
        {% assign remaining = free_shipping_threshold | minus: cart.total_price %}
        {% assign progress = cart.total_price | times: 100 | divided_by: free_shipping_threshold %}
        {% if progress > 100 %}{% assign progress = 100 %}{% endif %}
        <div class="pet-cart-free-shipping" style="margin-bottom: 20px;">
          <p class="pet-cart-free-shipping-text" style="font-size: 0.85rem; text-align: center; margin-bottom: 8px;">
            {% if remaining > 0 %}
              Te faltan <strong>{{ remaining | money }}</strong> para envío gratis 🚚
            {% else %}
              ¡Tienes envío gratis! 🎉
            {% endif %}
          </p>
          <div class="pet-cart-free-shipping-bar {% if remaining <= 0 %}complete{% endif %}">
            <div class="pet-cart-free-shipping-progress" style="width: {{ progress }}%;"></div>
          </div>
        </div>
      {% endif %}

      {% for item in cart.items %}
        <div class="mini-cart-item clearfix" style="display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--pet-border);">
          <div class="mini-cart-item-image" style="width: 70px; flex-shrink: 0;">
            <a href="{{ item.url }}">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;">
            </a>
          </div>
          <div class="mini-cart-item-des" style="flex: 1;">
            <h4 style="font-family: var(--font-body); font-size: 0.85rem; font-weight: 500; margin: 0 0 4px;">
              <a href="{{ item.url }}" style="color: var(--pet-navy); text-decoration: none;">{{ item.title }}</a>
            </h4>
            {% if item.variant.title != 'Default Title' %}
              <p style="font-size: 0.75rem; color: var(--pet-muted); margin: 0 0 4px;">{{ item.variant.title }}</p>
            {% endif %}
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-weight: 600; font-size: 0.9rem;">{{ item.price | money }}</span>
              <div style="display: flex; align-items: center; gap: 8px;">
                <button onclick="updateQty({{ forloop.index }}, {{ item.quantity | minus: 1 }})" style="width: 28px; height: 28px; border: 1px solid var(--pet-border); border-radius: 4px; background: white; cursor: pointer; font-size: 1rem;">−</button>
                <span style="font-size: 0.85rem; min-width: 20px; text-align: center;">{{ item.quantity }}</span>
                <button onclick="updateQty({{ forloop.index }}, {{ item.quantity | plus: 1 }})" style="width: 28px; height: 28px; border: 1px solid var(--pet-border); border-radius: 4px; background: white; cursor: pointer; font-size: 1rem;">+</button>
              </div>
            </div>
            <a href="#" onclick="removeItem({{ forloop.index }}, 0); return false;" style="font-size: 0.75rem; color: var(--pet-muted); text-decoration: underline; display: inline-block; margin-top: 4px;">Eliminar</a>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="mini-cart-action clearfix" style="padding-top: 16px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <span style="font-weight: 600;">Subtotal</span>
          <span style="font-weight: 700; font-size: 1.1rem;">{{ cart.items_subtotal_price | money }}</span>
        </div>
        <div class="mini-btn">
          <a href="/checkout" class="pet-btn pet-btn-primary" style="display: block; text-align: center; width: 100%;">Finalizar compra</a>
        </div>
        <a href="/cart" style="display: block; text-align: center; margin-top: 12px; font-size: 0.85rem; color: var(--pet-muted);">Ver carrito completo</a>
      </div>
    {% else %}
      <div style="text-align: center; padding: 40px 0;">
        <p style="font-size: 3rem; margin-bottom: 8px;">🛒</p>
        <p style="color: var(--pet-muted);">Tu carrito está vacío</p>
        <a href="/collections" class="pet-btn pet-btn-primary pet-btn-sm" style="margin-top: 16px;">Explorar productos</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de Navegación Shopify",
      "default": "main-menu",
      "info": "Selecciona el menú creado en Tienda Online > Navegación"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "Envío gratis desde 50 € · Diseñado para vivir mejor con ellos 🐾"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Texto Inicio",
      "default": "Inicio"
    },
    {
      "type": "text",
      "id": "perros_text",
      "label": "Texto Perros",
      "default": "Perros"
    },
    {
      "type": "url",
      "id": "perros_url",
      "label": "URL Perros"
    },
    {
      "type": "text",
      "id": "gatos_text",
      "label": "Texto Gatos",
      "default": "Gatos"
    },
    {
      "type": "url",
      "id": "gatos_url",
      "label": "URL Gatos"
    },
    {
      "type": "text",
      "id": "casa_text",
      "label": "Texto Casa",
      "default": "Casa"
    },
    {
      "type": "url",
      "id": "casa_url",
      "label": "URL Casa"
    },
    {
      "type": "text",
      "id": "viajar_text",
      "label": "Texto Viajar",
      "default": "Viajar"
    },
    {
      "type": "url",
      "id": "viajar_url",
      "label": "URL Viajar"
    },
    {
      "type": "text",
      "id": "pasear_text",
      "label": "Texto Pasear",
      "default": "Pasear"
    },
    {
      "type": "url",
      "id": "pasear_url",
      "label": "URL Pasear"
    },
    {
      "type": "text",
      "id": "ofertas_text",
      "label": "Texto Ofertas",
      "default": "Ofertas"
    },
    {
      "type": "url",
      "id": "ofertas_url",
      "label": "URL Ofertas"
    },
    {
      "type": "text",
      "id": "blog_text",
      "label": "Texto Blog",
      "default": "Blog"
    },
    {
      "type": "url",
      "id": "blog_url",
      "label": "URL Blog"
    }
  ]
}
{% endschema %}
