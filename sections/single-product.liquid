    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostrar botones de compra dinámica (Apple Pay, PayPal, Shop Pay)",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Texto envío",
      "default": "Envío 3-6 días laborables a España y Europa"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Texto devoluciones",
      "default": "14 días de devolución sin complicaciones"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Texto garantía",
      "default": "Materiales seguros y certificados UE"
    }
  ],
  "presets": [
    {
      "name": "Producto"
    }
  ]
}
{% endschema %}
