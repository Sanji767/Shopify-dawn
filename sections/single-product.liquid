<script>
  window.product = {{ product | json }} || {};
</script>

<section class="pet-product-page">
  <div class="pet-container">
    <div class="row">
      <!-- Gallery -->
      <div class="col-lg-6 col-12">
        <div class="pet-product-gallery">
          <div class="pet-product-gallery-main" id="mainImage">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 1024 }}" alt="{{ product.title }}" id="mainProductImg">
            {% endif %}
          </div>
          <div class="pet-product-gallery-thumbs">
            {% for image in product.images %}
              <div class="pet-product-gallery-thumb {% if forloop.first %}active{% endif %}" onclick="changeMainImage(this, '{{ image.src | image_url: width: 1024 }}')">
                <img src="{{ image.src | image_url: width: 200 }}" alt="{{ product.title }} - {{ forloop.index }}">
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Product Info -->
      <div class="col-lg-6 col-12">
        <div class="pet-product-info">
          <h1>{{ product.title }}</h1>

          <!-- Price -->
          <div class="pet-product-price-wrap">
            <span class="pet-product-price">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="pet-product-compare-price">{{ product.compare_at_price | money }}</span>
              {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
              <span class="pet-product-discount-badge">-{{ discount }}%</span>
            {% endif %}
          </div>

          <!-- Variants -->
          {% if product.has_only_default_variant == false %}
            {% for option in product.options_with_values %}
              <div class="pet-product-variants">
                <label class="pet-product-variant-label">{{ option.name }}</label>
                <div class="pet-product-variant-options">
                  {% for value in option.values %}
                    <button class="pet-product-variant-option {% if forloop.first %}active{% endif %}" data-option="{{ option.name }}" data-value="{{ value }}">
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endif %}

          <!-- Quantity -->
          <div class="pet-product-qty">
            <label class="pet-product-variant-label" style="margin-right: 12px; margin-bottom: 0;">Cantidad</label>
            <button type="button" onclick="updateProductQty(-1)">−</button>
            <input type="text" value="1" id="productQty" readonly>
            <button type="button" onclick="updateProductQty(1)">+</button>
          </div>

          <input type="hidden" name="id" id="variantId" value="{{ product.variants.first.id }}">
          <input type="hidden" name="quantity" id="quantity" value="1" min="1">

          <!-- Actions -->
          <div class="pet-product-actions">
            <a href="#" class="pet-btn pet-btn-primary addToCart">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              Añadir al carrito
            </a>
            {% if product.available %}
              <a href="/checkout?add={{ product.variants.first.id }}:1" class="pet-btn pet-btn-secondary">
                Comprar ahora
              </a>
            {% endif %}
          </div>

          <!-- Meta info -->
          <div class="pet-product-meta">
            <div class="pet-product-meta-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {{ section.settings.shipping_text }}
            </div>
            <div class="pet-product-meta-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              {{ section.settings.returns_text }}
            </div>
            <div class="pet-product-meta-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {{ section.settings.guarantee_text }}
            </div>
          </div>

          <!-- Accordions -->
          <div class="pet-accordion">
            <div class="pet-accordion-item">
              <button class="pet-accordion-trigger" onclick="toggleAccordion(this)">
                Descripción
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="pet-accordion-content">
                <div class="pet-accordion-content-inner">
                  {{ product.description }}
                </div>
              </div>
            </div>
            {% if section.settings.features_text != blank %}
              <div class="pet-accordion-item">
                <button class="pet-accordion-trigger" onclick="toggleAccordion(this)">
                  Características
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="pet-accordion-content">
                  <div class="pet-accordion-content-inner">
                    {{ section.settings.features_text }}
                  </div>
                </div>
              </div>
            {% endif %}
            {% if section.settings.faq_text != blank %}
              <div class="pet-accordion-item">
                <button class="pet-accordion-trigger" onclick="toggleAccordion(this)">
                  Preguntas frecuentes
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="pet-accordion-content">
                  <div class="pet-accordion-content-inner">
                    {{ section.settings.faq_text }}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto",
  "settings": [
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Texto envío",
      "default": "Envío en 2-4 días laborables"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Texto devoluciones",
      "default": "Devolución gratuita en 30 días"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Texto garantía",
      "default": "Pago 100% seguro"
    },
    {
      "type": "richtext",
      "id": "features_text",
      "label": "Texto de características"
    },
    {
      "type": "richtext",
      "id": "faq_text",
      "label": "Preguntas frecuentes"
    }
  ],
  "presets": [
    {
      "name": "Producto"
    }
  ]
}
{% endschema %}
