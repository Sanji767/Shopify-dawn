<script>
  window.product = {{ product | json }} || {};
</script>

<section class="pet-product-page" style="padding: 60px 0;">
  <div class="pet-container container">
    <div class="row">
      <!-- Gallery -->
      <div class="col-lg-6 col-12 mb-4">
        <div class="pet-product-gallery">
          <div class="pet-product-gallery-main" id="mainImage" style="background: linear-gradient(135deg, #FBF8F3 0%, #F5EDE3 100%); border-radius: 24px; padding: 20px; min-height: 400px; display: flex; align-items: center; justify-content: center;">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 1024 }}" alt="{{ product.title }}" id="mainProductImg" style="max-width: 100%; height: auto; border-radius: 16px;">
            {% else %}
              <div style="font-size: 6rem; text-align: center;">🐶 🐾</div>
            {% endif %}
          </div>
          {% if product.images.size > 1 %}
            <div class="pet-product-gallery-thumbs" style="display: flex; gap: 12px; margin-top: 16px;">
              {% for image in product.images %}
                <div class="pet-product-gallery-thumb {% if forloop.first %}active{% endif %}" onclick="changeMainImage(this, '{{ image.src | image_url: width: 1024 }}')" style="width: 80px; height: 80px; border-radius: 12px; overflow: hidden; border: 2px solid #E5E1DB; cursor: pointer;">
                  <img src="{{ image.src | image_url: width: 200 }}" alt="{{ product.title }} - {{ forloop.index }}" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Product Info -->
      <div class="col-lg-6 col-12">
        <div class="pet-product-info">
          <!-- Stock & Review Rating CRO -->
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: #166534; font-weight: 600;">
              <span style="width: 8px; height: 8px; border-radius: 50%; background: #22C55E; display: inline-block;"></span>
              En stock en España (3-6 días)
            </div>
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.85rem;">
              <span style="color: #F59E0B;">★★★★★</span>
              <span style="font-weight: 700; color: var(--pet-navy);">4.9</span>
              <span style="color: var(--pet-muted);">(128 opiniones)</span>
            </div>
          </div>

          <h1 style="font-family: 'DM Serif Display', serif; font-size: 2.5rem; color: var(--pet-navy); margin-bottom: 12px;">
            {{ product.title | default: "Cama Ortopédica Lavable para Mascotas" }}
          </h1>

          <!-- Urgency Banner -->
          <div style="background: #FFFBEB; border: 1px solid #FCD34D; padding: 10px 16px; border-radius: 12px; font-size: 0.85rem; font-weight: 600; color: #92400E; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <span>⚡ Pide en las próximas 02h 45m para envío prioritario hoy</span>
          </div>

          <!-- Price -->
          <div class="pet-product-price-wrap" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="pet-product-price" style="font-family: 'Inter', sans-serif; font-size: 1.75rem; font-weight: 700; color: var(--pet-navy);">
              {{ product.price | default: 3499 | money }}
            </span>
            {% if product.compare_at_price > product.price or product.title == blank %}
              <span class="pet-product-compare-price" style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: var(--pet-muted); text-decoration: line-through;">
                {{ product.compare_at_price | default: 4499 | money }}
              </span>
              <span class="pet-product-discount-badge" style="background: var(--pet-coral); color: #fff; padding: 4px 10px; border-radius: 50px; font-size: 0.8rem; font-weight: 700;">
                OFERTA -22%
              </span>
            {% endif %}
          </div>

          {% form 'product', product, id: 'AddToCartForm', class: 'pet-product-form' %}
            <!-- Variants -->
            {% if product.has_only_default_variant == false %}
              {% for option in product.options_with_values %}
                <div class="pet-product-variants" style="margin-bottom: 20px;">
                  <label class="pet-product-variant-label" style="font-weight: 600; margin-bottom: 8px; display: block;">{{ option.name }}</label>
                  <div class="pet-product-variant-options" style="display: flex; gap: 10px; flex-wrap: wrap;">
                    {% for value in option.values %}
                      <button type="button" class="pet-product-variant-option {% if forloop.first %}active{% endif %}" data-option="{{ option.name }}" data-value="{{ value }}" style="padding: 8px 16px; border-radius: 50px; border: 1px solid var(--pet-border); background: #fff; cursor: pointer;">
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            {% endif %}

            <!-- Quantity -->
            <div class="pet-product-qty" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
              <label class="pet-product-variant-label" style="font-weight: 600; margin: 0;">Cantidad</label>
              <div style="display: flex; align-items: center; border: 1px solid var(--pet-border); border-radius: 50px; overflow: hidden; background: #fff;">
                <button type="button" onclick="updateProductQty(-1)" style="padding: 8px 16px; border: none; background: transparent; cursor: pointer; font-weight: 700;">−</button>
                <input type="text" value="1" id="productQty" name="quantity" readonly style="width: 40px; text-align: center; border: none; font-weight: 600;">
                <button type="button" onclick="updateProductQty(1)" style="padding: 8px 16px; border: none; background: transparent; cursor: pointer; font-weight: 700;">+</button>
              </div>
            </div>

            <input type="hidden" name="id" id="variantId" value="{{ product.variants.first.id | default: 1 }}">

            <!-- Actions -->
            <div class="pet-product-actions" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px;">
              <button type="submit" name="add" class="pet-btn pet-btn-primary pet-btn-lg" style="width: 100%; justify-content: center; font-size: 1.1rem; padding: 16px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                Añadir al carrito
              </button>
              <div style="text-align: center; font-size: 0.8rem; color: var(--pet-muted);">
                🔒 Pago 100% Seguro · Visa, Mastercard, PayPal, Apple Pay, Klarna, iDEAL
              </div>
            </div>
          {% endform %}

          <!-- Meta info -->
          <div class="pet-product-meta" style="background: #FBF8F3; padding: 20px; border-radius: 16px; border: 1px solid #E5E1DB; margin-bottom: 32px;">
            <div class="pet-product-meta-item" style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 0.9rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>{{ section.settings.shipping_text }}</span>
            </div>
            <div class="pet-product-meta-item" style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 0.9rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              <span>{{ section.settings.returns_text }}</span>
            </div>
            <div class="pet-product-meta-item" style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>{{ section.settings.guarantee_text }}</span>
            </div>
          </div>

          <!-- Description & Details -->
          <div class="pet-product-description" style="line-height: 1.7; color: var(--pet-navy);">
            <h3 style="font-family: 'DM Serif Display', serif; font-size: 1.3rem; margin-bottom: 12px;">Descripción del producto</h3>
            <div>
              {{ product.description | default: "<p>Diseñada para proporcionar el máximo confort y descanso a tu mascota. Material resistente, lavable a máquina y con base antideslizante para la máxima estabilidad en tu hogar.</p>" }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function updateProductQty(delta) {
    var input = document.getElementById('productQty');
    var val = parseInt(input.value) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
  }
  function changeMainImage(element, newSrc) {
    document.getElementById('mainProductImg').src = newSrc;
    document.querySelectorAll('.pet-product-gallery-thumb').forEach(function(el) {
      el.classList.remove('active');
    });
    element.classList.add('active');
  }
</script>

{% schema %}
{
  "name": "Producto",
  "settings": [
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Texto envío",
      "default": "Envío a España y Europa en 3-6 días laborables"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Texto devoluciones",
      "default": "Devolución sin preguntas en 14 días (RGPD)"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Texto garantía",
      "default": "Pago 100% seguro con SSL y soporte en español"
    }
  ],
  "presets": [
    {
      "name": "Producto"
    }
  ]
}
{% endschema %}
