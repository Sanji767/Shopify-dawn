{{ 'pet-theme.css' | asset_url | stylesheet_tag }}

<section class="pet-section pet-bundles-section" style="background-color: {{ section.settings.background_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pet-container container">
    {% if section.settings.title != blank %}
      <h2 class="pet-section-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="pet-section-subtitle" style="color: {{ section.settings.subtitle_color }};">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    <div class="pet-bundles-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="pet-bundle-col" {{ block.shopify_attributes }}>
            <article class="pet-bundle-card">
              <div class="pet-bundle-card__image-wrapper">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title }}"
                    width="800"
                    height="600"
                    loading="lazy"
                    class="pet-bundle-card__image"
                  >
                {% else %}
                  <div class="pet-bundle-card__placeholder">
                    <span class="pet-bundle-placeholder-icon">📦 🐾</span>
                  </div>
                {% endif %}

                {% if block.settings.badge != blank %}
                  <span class="pet-bundle-card__badge">{{ block.settings.badge }}</span>
                {% endif %}
              </div>

              <div class="pet-bundle-card__content">
                {% if block.settings.title != blank %}
                  <h3 class="pet-bundle-card__title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <p class="pet-bundle-card__description">{{ block.settings.description }}</p>
                {% endif %}

                <div class="pet-bundle-price-wrap" style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                  <span class="pet-bundle-price" style="font-family: 'Inter', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--pet-navy);">{{ block.settings.price | default: '49,99 €' }}</span>
                  {% if block.settings.compare_price != blank %}
                    <span class="pet-bundle-compare-price" style="font-family: 'Inter', sans-serif; font-size: 0.9rem; color: var(--pet-muted); text-decoration: line-through;">{{ block.settings.compare_price }}</span>
                  {% endif %}
                </div>

                <div class="pet-bundle-includes">
                  <div class="pet-bundle-check">✓ Envío gratis (3-6 días)</div>
                  <div class="pet-bundle-check">✓ Selección de esenciales</div>
                </div>

                <a href="{{ block.settings.link | default: '/collections/all' }}" class="pet-bundle-card__link">
                  {{ block.settings.link_text | default: 'Ver pack' }}
                  <svg class="pet-bundle-card__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </article>
          </div>
        {% endfor %}
      {% else %}
        {% assign default_titles = "Home Pack,Travel Pack,Walk Pack,New Pet Pack" | split: "," %}
        {% assign default_descs = "Todo lo que necesitas para mantener tu casa limpia y organizada con tu mascota.,Viaja tranquilo con todo lo necesario para el coche y el trayecto.,Paseos más cómodos y organizados con los accesorios indispensables.,¿Acabas de adoptar? Este pack tiene todo lo básico para empezar." | split: "," %}
        {% assign default_badges = "Popular,,Recomendado,Nuevo" | split: "," %}
        {% assign default_prices = "49,99 €,39,99 €,34,99 €,59,99 €" | split: "," %}
        {% assign default_compares = "64,99 €,49,99 €,44,99 €,74,99 €" | split: "," %}
        {% for i in (0..3) %}
          <div class="pet-bundle-col">
            <article class="pet-bundle-card">
              <div class="pet-bundle-card__image-wrapper">
                <div class="pet-bundle-card__placeholder">
                  <span class="pet-bundle-placeholder-icon">📦 🐾</span>
                </div>
                {% if default_badges[i] != blank %}
                  <span class="pet-bundle-card__badge">{{ default_badges[i] }}</span>
                {% endif %}
              </div>
              <div class="pet-bundle-card__content">
                <h3 class="pet-bundle-card__title">{{ default_titles[i] }}</h3>
                <p class="pet-bundle-card__description">{{ default_descs[i] }}</p>

                <div class="pet-bundle-price-wrap" style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                  <span class="pet-bundle-price" style="font-family: 'Inter', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--pet-navy);">{{ default_prices[i] }}</span>
                  <span class="pet-bundle-compare-price" style="font-family: 'Inter', sans-serif; font-size: 0.9rem; color: var(--pet-muted); text-decoration: line-through;">{{ default_compares[i] }}</span>
                </div>

                <div class="pet-bundle-includes">
                  <div class="pet-bundle-check">✓ Envío gratis (3-6 días)</div>
                  <div class="pet-bundle-check">✓ Selección de esenciales</div>
                </div>

                <a href="/collections/all" class="pet-bundle-card__link">
                  Ver pack
                  <svg class="pet-bundle-card__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </article>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pet-bundles-section {
    background-color: var(--pet-white, #FFFFFF);
  }
  .pet-bundles-section .pet-section-title {
    font-family: 'DM Serif Display', serif;
    font-size: 2.5rem;
    color: var(--pet-navy, #1A2B4A);
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .pet-bundles-section .pet-section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: var(--pet-muted, #6B7280);
    text-align: center;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .pet-bundles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    width: 100%;
  }
  .pet-bundle-col {
    width: 100%;
    display: flex;
  }
  .pet-bundle-card {
    background-color: #FBF8F3;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #E5E1DB;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }
  .pet-bundle-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 36px rgba(26, 43, 74, 0.1);
    border-color: var(--pet-coral);
  }
  .pet-bundle-card__image-wrapper {
    position: relative;
    width: 100%;
    padding-top: 70%;
    overflow: hidden;
    background: #F5EDE3;
  }
  .pet-bundle-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pet-bundle-card__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #F5EDE3 0%, #EADECF 100%);
  }
  .pet-bundle-placeholder-icon {
    font-size: 3rem;
  }
  .pet-bundle-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: var(--pet-coral);
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 12px rgba(232, 115, 74, 0.3);
  }
  .pet-bundle-card__content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
  }
  .pet-bundle-card__title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.35rem;
    color: var(--pet-navy, #1A2B4A);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .pet-bundle-card__description {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--pet-muted, #6B7280);
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .pet-bundle-includes {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pet-bundle-check {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--pet-sage);
  }
  .pet-bundle-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #FFFFFF;
    background-color: var(--pet-navy);
    padding: 12px 20px;
    border-radius: 50px;
    text-decoration: none;
    margin-top: auto;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .pet-bundle-card:hover .pet-bundle-card__link {
    background-color: var(--pet-coral);
  }

  @media (max-width: 991px) {
    .pet-bundles-section .pet-section-title { font-size: 2rem; }
    .pet-bundles-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 575px) {
    .pet-bundles-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>

{% schema %}
{
  "name": "Packs & Bundles",
  "tag": "section",
  "class": "pet-bundles-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Todo lo que necesitas, en un solo pack."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Ahorra y equípate al completo con nuestros packs seleccionados"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#1A2B4A"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del subtítulo",
      "default": "#6B7280"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Pack",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del pack"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta / Badge",
          "default": "Popular"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Home Pack"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Todo lo que necesitas para mantener tu casa limpia y organizada con tu mascota."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio",
          "default": "49,99 €"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Precio anterior",
          "default": "64,99 €"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Texto del enlace",
          "default": "Ver pack"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del pack"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Packs & Bundles"
    }
  ]
}
{% endschema %}
