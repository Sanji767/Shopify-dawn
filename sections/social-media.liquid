<!-- UGC / Social Gallery -->
<section class="pet-section" style="background: var(--pet-warm);">
  <div class="pet-container">
    <div class="pet-section-title">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>
    <div class="pet-ugc-grid">
      {% for block in section.blocks %}
        <div class="pet-ugc-item">
          {% if block.settings.url != blank %}
            <a href="{{ block.settings.url }}" target="_blank" rel="noopener">
          {% endif %}
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ section.settings.title }}" loading="lazy">
            {% else %}
              <div style="width: 100%; height: 100%; background: var(--pet-border); display: flex; align-items: center; justify-content: center; font-size: 2rem;">📷</div>
            {% endif %}
          {% if block.settings.url != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Galería Social",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "#VidaConMascota"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Comparte tu momento — Síguenos en Instagram"
    }
  ],
  "blocks": [
    {
      "name": "Imagen",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galería Social",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
