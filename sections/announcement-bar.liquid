<div class="pet-announcement-wrapper" style="background: linear-gradient(90deg, #1A2B4A 0%, #22375C 50%, #1A2B4A 100%); color: {{ section.settings.text_color | default: '#FFFFFF' }}; text-align: center; padding: 10px 16px; font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.02em; border-bottom: 1px solid rgba(255,255,255,0.08);">
  <div class="pet-container container" style="display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap;">
    <span style="display: inline-flex; align-items: center; gap: 6px;">🐾 <strong>Paw & Home:</strong> Hecho con amor para ti y para ellos</span>
    <span style="opacity: 0.5; display: none; @media(min-width: 768px){ display: inline; }">·</span>
    <span style="display: inline-flex; align-items: center; gap: 6px;">🚚 <strong>Envío Gratis</strong> desde 50 €</span>
    <span style="opacity: 0.5; display: none; @media(min-width: 768px){ display: inline; }">·</span>
    <span style="display: inline-flex; align-items: center; gap: 6px;">💚 <strong>14 días</strong> de prueba sin compromiso</span>
  </div>
</div>

{% schema %}
{
  "name": "Barra de anuncio",
  "tag": "section",
  "class": "pet-announcement-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "Envío gratis en pedidos superiores a 50 € · Envíos 3-6 días laborables 🐾"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1A2B4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncio"
    }
  ]
}
{% endschema %}
