<div class="pet-announcement-wrapper" style="background-color: {{ section.settings.background_color | default: '#1A2B4A' }}; color: {{ section.settings.text_color | default: '#FFFFFF' }}; text-align: center; padding: 10px 16px; font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.02em;">
  <div class="pet-container container" style="display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;">
    <span>{{ section.settings.announcement_text | default: "Envío gratis en pedidos superiores a 50 € · Envíos 3-6 días laborables 🐾" }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Barra de anuncio",
  "tag": "section",
  "class": "pet-announcement-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "Envío gratis en pedidos superiores a 50 € · Envíos 3-6 días laborables 🐾"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1A2B4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncio"
    }
  ]
}
{% endschema %}
