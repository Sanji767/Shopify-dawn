<div class="pet-announcement-bar">
  <div class="pet-container">
    <div class="pet-announcement-items">
      <span class="pet-announcement-item pet-announcement-item--main">
        🐾 <strong>Paw & Home:</strong> Hecho con amor para ti y para ellos
      </span>
      <span class="pet-announcement-sep">·</span>
      <span class="pet-announcement-item">
        🚚 <strong>Envío Gratis</strong> desde 50 €
      </span>
      <span class="pet-announcement-sep">·</span>
      <span class="pet-announcement-item">
        💚 <strong>14 días</strong> de prueba sin compromiso
      </span>
    </div>
  </div>
</div>

<style>
  .pet-announcement-bar {
    background: linear-gradient(90deg, #1A2B4A 0%, #22375C 50%, #1A2B4A 100%);
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    text-align: center;
    padding: 7px 12px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pet-announcement-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: nowrap;
  }
  .pet-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .pet-announcement-sep {
    opacity: 0.4;
  }
  @media (max-width: 768px) {
    .pet-announcement-bar {
      padding: 6px 8px;
      font-size: 0.74rem;
    }
    .pet-announcement-sep,
    .pet-announcement-item:not(.pet-announcement-item--main) {
      display: none !important;
    }
    .pet-announcement-item--main {
      font-size: 0.74rem;
      white-space: normal;
      line-height: 1.3;
    }
  }
</style>

{% schema %}
{
  "name": "Barra de anuncio",
  "tag": "section",
  "class": "pet-announcement-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "Envío gratis en pedidos superiores a 50 € · Envíos 3-6 días laborables 🐾"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1A2B4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncio"
    }
  ]
}
{% endschema %}
