<!-- Feature Section / Brand Values -->
<section class="pet-section pet-features-section">
  <div class="pet-container container">
    <div class="pet-section-title" style="text-align: center; margin-bottom: 2.5rem;">
      <h2 style="font-family: var(--font-heading); font-size: 2.5rem; color: var(--pet-navy); margin-bottom: 0.5rem;">
        {% if request.locale.iso_code == 'en' %}
          Made by and for those who cannot imagine life without pets
        {% else %}
          {{ section.settings.title }}
        {% endif %}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p style="font-family: 'Inter', sans-serif; font-size: 1.05rem; color: var(--pet-muted); max-width: 600px; margin: 0 auto;">
          {% if request.locale.iso_code == 'en' %}
            Love, respect, and quality in every corner of our store
          {% else %}
            {{ section.settings.subtitle }}
          {% endif %}
        </p>
      {% endif %}
    </div>

    <div class="pet-features-grid">
      {% for block in section.blocks %}
        <div class="pet-feature-col" {{ block.shopify_attributes }}>
          <div class="pet-feature-card">
            <div class="pet-feature-icon-wrapper">
              <span class="pet-feature-icon">{{ block.settings.icon }}</span>
            </div>
            <h3>
              {% if request.locale.iso_code == 'en' %}
                {% case block.settings.feature_title %}
                  {% when 'Amor en cada detalle' %}Love in Every Detail
                  {% when 'Pensado para la vida real' %}Designed for Real Life
                  {% when 'Siempre a tu lado' %}Always By Your Side
                  {% else %}{{ block.settings.feature_title }}
                {% endcase %}
              {% else %}
                {{ block.settings.feature_title }}
              {% endif %}
            </h3>
            <p>
              {% if request.locale.iso_code == 'en' %}
                {% if forloop.index == 1 %}
                  We only select comfortable, safe, durable products we would use with our own furry companions.
                {% elsif forloop.index == 2 %}
                  We know the feeling of a fur-covered sofa or muddy paws after a walk. We help you enjoy life together stress-free.
                {% elsif forloop.index == 3 %}
                  We speak your language: passionate about their happiness and well-being. Message us anytime you need.
                {% else %}
                  {{ block.settings.description }}
                {% endif %}
              {% else %}
                {{ block.settings.description }}
              {% endif %}
            </p>
          </div>
        </div>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        {% assign default_icons = "✨,🏠,💚" | split: "," %}
        {% capture feat_titles %}{{ 'paw.features.title_1' | t }},{{ 'paw.features.title_2' | t }},{{ 'paw.features.title_3' | t }}{% endcapture %}
        {% assign default_titles = feat_titles | split: "," %}
        {% capture feat_descs %}{{ 'paw.features.desc_1' | t }},{{ 'paw.features.desc_2' | t }},{{ 'paw.features.desc_3' | t }}{% endcapture %}
        {% assign default_descs = feat_descs | split: "," %}
        {% for i in (0..2) %}
          <div class="pet-feature-col">
            <div class="pet-feature-card">
              <div class="pet-feature-icon-wrapper">
                <span class="pet-feature-icon">{{ default_icons[i] }}</span>
              </div>
              <h3>{{ default_titles[i] }}</h3>
              <p>{{ default_descs[i] }}</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pet-features-section {
    background-color: var(--pet-white, #FFFFFF);
    padding: 80px 0;
  }
  .pet-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
  }
  .pet-feature-col {
    width: 100%;
    display: flex;
  }
  .pet-feature-card {
    background: #FBF8F3;
    border: 1px solid #E5E1DB;
    border-radius: 20px;
    padding: 36px 28px;
    text-align: center;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .pet-feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(26, 43, 74, 0.08);
    border-color: var(--pet-coral);
  }
  .pet-feature-icon-wrapper {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 4px 14px rgba(26, 43, 74, 0.06);
    border: 1px solid #E5E1DB;
  }
  .pet-feature-icon {
    font-size: 2rem;
    line-height: 1;
  }
  .pet-feature-card h3 {
    font-family: var(--font-heading) !important;
    font-size: 1.4rem !important;
    color: var(--pet-navy) !important;
    margin-bottom: 12px !important;
  }
  .pet-feature-card p {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.95rem !important;
    color: var(--pet-muted) !important;
    line-height: 1.6 !important;
    margin: 0 !important;
  }

  @media (max-width: 991px) {
    .pet-features-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (max-width: 575px) {
    .pet-features-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>

{% schema %}
{
  "name": "Valores de Marca",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "¿Por qué elegirnos?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Productos pensados para ti y para ellos"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Valor",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icono (emoji)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Título",
          "default": "Calidad premium"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Seleccionamos cada producto para garantizar la mejor calidad para tu mascota y para ti."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valores de Marca"
    }
  ]
}
{% endschema %}
