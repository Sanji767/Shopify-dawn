{% comment %}
Placeholder email signup banner section for password page.
{% endcomment %}
<div class="email-signup-banner">
  <form method="post" action="/contact" class="email-signup-form" style="display:flex; gap:8px; align-items:center;">
    <input type="email" name="contact[email]" placeholder="{{ 'paw.email_signup.placeholder' | t }}" required class="input-email" style="flex:1; padding:8px; border:1px solid var(--color-border); border-radius:4px;" />
    <button type="submit" class="btn-primary" style="padding:8px 16px;">{{ 'paw.email_signup.submit' | t }}</button>
  </form>
</div>
{% schema %}
{
  "name": "Email Signup Banner",
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {"type": "text", "id": "heading", "label": "Heading", "default": "Opening soon"},
        {"type": "select", "id": "heading_size", "label": "Size", "options": [{"value": "h1", "label": "H1"}, {"value": "h2", "label": "H2"}], "default": "h1"}
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to know when we launch.</p>"},
        {"type": "select", "id": "text_style", "label": "Style", "options": [{"value": "body", "label": "Body"}], "default": "body"}
      ]
    },
    {
      "type": "email_form",
      "name": "Email Form",
      "settings": []
    }
  ],
  "settings": []
}
{% endschema %}
